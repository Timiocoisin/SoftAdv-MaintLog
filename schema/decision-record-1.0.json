{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softadv.example/schema/decision-record-1.0.json",
  "title": "Maintenance handover decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "asset", "campaign", "stage", "pass",
               "log", "evidence", "decision", "rationale", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": { "type": "string", "pattern": "^DR-[0-9]{6}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "component_type"],
      "properties": {
        "asset_id": { "type": "string" },
        "component_type": { "type": "string" }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "window_start", "window_end", "planned_stages"],
      "properties": {
        "campaign_id": { "type": "string" },
        "window_start": { "type": "string", "format": "date-time" },
        "window_end": { "type": "string", "format": "date-time" },
          "planned_stages": { "type": "integer", "minimum": 1 }
      }
    },
    "stage": { "type": "integer", "minimum": 0 },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "window_start", "window_end"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "window_start": { "type": "string", "format": "date-time" },
        "window_end": { "type": "string", "format": "date-time" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "writer_id", "written_at", "sheet_id"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "writer_id": { "type": "string" },
        "written_at": { "type": "string", "format": "date-time" },
        "sheet_id": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "frame_uri", "estimate", "gate",
                     "confidence", "captured_at"],
        "properties": {
          "evidence_id": { "type": "string" },
          "frame_uri": { "type": "string", "format": "uri" },
          "estimate": { "type": "number", "minimum": 0 },
          "gate": { "enum": ["usable", "weak", "absent"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "decision": { "enum": ["PASS", "REVIEW"] },
    "threshold": { "type": "integer", "minimum": 0 },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "evidence_refs", "margin", "expected_cost"],
      "properties": {
        "rule_id": { "enum": ["R1", "R2", "R3", "R4", "R5"] },
        "evidence_refs": { "type": "array", "minItems": 1,
                           "items": { "type": "string" } },
        "margin": { "type": "number" },
        "expected_cost": { "type": "number", "minimum": 0 }
      }
    },
    "override": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["response", "operator_id", "decided_at"],
          "properties": {
            "response": { "enum": ["follow", "change", "dismiss"] },
            "operator_id": { "type": "string" },
            "decided_at": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version", "operator_id", "recorded_at", "prev_hash"],
      "properties": {
        "rule_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
        "operator_id": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "prev_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
